dist/

# Compilazioni Rust (pesanti, si ricreano con cargo)
target/

# Schemi generati da Tauri durante la compilazione
src-tauri/gen/schemas/

# File di sistema e degli editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.log
